DATABASE_URL=postgres://rtx:rtx@localhost:5432/rtx_estoque_importacao
PORT=3333

# Módulo de decisão de compra (opcionais — sem eles, os defaults abaixo valem
# e a leitura de venda do painel-gbw fica vazia em vez de quebrar)
# PAINEL_DATABASE_URL — conexão Postgres DIRETA do projeto Supabase compartilhado
# (financeiro-gbw/painel-gbw, projeto ylbszminytbmnwkknixy), não uma URL do app do
# painel-gbw no Railway — o Railway hospeda só o servidor Node dele, os dados
# (vendas_mensais, inventario_full) moram no Supabase. Pegar em
# Supabase → Project Settings → Database → Connection string (URI).
# PAINEL_DATABASE_URL=postgres://usuario:senha@host:5432/painel_gbw
# LEAD_TIME_DIAS=90
# COBERTURA_MINIMA_MESES=2
# CRESCIMENTO_MENSAL=1.1
# CAMBIO=5.4
# JANELA_MESES=9

# Busca de produtos no Tiny (api2, token por empresa) — opcional; sem ele o
# campo de busca no cadastro de produto fica indisponível em vez de quebrar.
# Token DA CONTA RTX especificamente — BG/BW/BRA têm cada uma sua própria conta
# Tiny (não compartilham estoque).
# TINY_TOKEN_RTX=

# Com TINY_TOKEN_RTX configurado, um job em background sincroniza sozinho um
# pouco de estoque a cada poucos minutos (sempre os produtos mais desatualizados
# primeiro), pra nunca precisar de sincronização manual e nunca bater no rate
# limit do Tiny numa rajada só. Desligar com:
# DISABLE_ESTOQUE_AUTOSYNC=1
