DATABASE_URL=postgres://rtx:rtx@localhost:5432/rtx_estoque_importacao
PORT=3333

# Módulo de decisão de compra (opcionais — sem eles, os defaults abaixo valem
# e a leitura de venda do painel-gbw fica vazia em vez de quebrar)
# PAINEL_DATABASE_URL=postgres://usuario:senha@host:5432/painel_gbw
# LEAD_TIME_DIAS=90
# COBERTURA_MINIMA_MESES=2
# CRESCIMENTO_MENSAL=1.1
# CAMBIO=5.4
# JANELA_MESES=9

# Busca de produtos no Tiny (api2, token por empresa) — opcional; sem ele o
# campo de busca no cadastro de produto fica indisponível em vez de quebrar.
# TINY_TOKEN_RTX=
